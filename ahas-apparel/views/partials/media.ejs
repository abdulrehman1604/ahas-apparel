<%
// Usage: include('partials/media', { image: p.image, icon: sub.icon, alt: p.name, ratio: 'aspect-[4/5]' })
const ratioClass = typeof ratio !== 'undefined' ? ratio : 'aspect-[4/5]';
%>
<% if (typeof image !== 'undefined' && image) { %>
  <div class="<%= ratioClass %> w-full overflow-hidden bg-paper-dim">
    <img src="<%= image %>" alt="<%= typeof alt !== 'undefined' ? alt : '' %>" loading="lazy" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
  </div>
<% } else { %>
  <div class="<%= ratioClass %> w-full flex items-center justify-center bg-paper-dim border-b border-dashed border-line">
    <div class="w-1/2 h-1/2 text-denim/80">
      <%- include('icon', { name: icon }) %>
    </div>
  </div>
<% } %>
