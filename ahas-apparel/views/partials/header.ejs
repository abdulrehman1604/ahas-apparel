<header class="sticky top-0 z-50 bg-paper/95 backdrop-blur-md border-b border-line">
  <div class="max-w-[1280px] mx-auto px-6 h-20 flex items-center justify-between">

    <!-- ============ LOGO ============ -->
    <a href="/" class="flex items-center gap-3 shrink-0">
      <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange to-orange-deep flex items-center justify-center text-white font-display font-bold text-lg shadow-md shadow-orange/25">A</span>
      <span class="flex flex-col leading-none">
        <span class="font-display font-bold text-xl text-ink tracking-tight">Ahas<span class="text-orange">.</span></span>
        <span class="font-mono text-[9px] tracking-[0.22em] text-ink-soft uppercase mt-0.5">Apparel Co.</span>
      </span>
    </a>

    <!-- ============ DESKTOP NAV ============ -->
    <nav class="hidden lg:flex items-center gap-8" id="mainNav">
      <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a>

      <!-- Catalog mega-menu -->
      <div class="relative group">
        <button type="button" class="nav-link flex items-center gap-1.5 <%= currentPath.startsWith('/catalog') ? 'active' : '' %>">
          Catalog
          <svg class="w-3 h-3 mt-0.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="absolute left-1/2 -translate-x-1/2 top-full pt-4 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 z-50">
          <div class="bg-white border border-line rounded-md shadow-2xl shadow-ink/10 p-7 grid grid-cols-4 gap-8 w-[760px]">
            <% navCategories.forEach(function(cat){ %>
              <div>
                <a href="/catalog#<%= cat.slug %>" class="font-display font-semibold text-sm text-ink hover:text-orange-deep transition-colors block mb-3 pb-2 border-b border-line"><%= cat.name %></a>
                <ul class="space-y-2">
                  <% cat.subcategories.forEach(function(sub){ %>
                    <li><a href="/catalog/<%= sub.slug %>" class="text-[13px] text-ink-soft hover:text-orange-deep transition-colors block"><%= sub.shortName || sub.name %></a></li>
                  <% }) %>
                </ul>
              </div>
            <% }) %>
          </div>
        </div>
      </div>

      <a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About</a>
      <a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
      <a href="/sample-request" class="btn btn-primary !py-2.5 !px-5 !text-xs">Request Samples</a>
    </nav>

    <button class="lg:hidden border border-ink/60 rounded-sm p-2.5" id="navToggle" aria-label="Toggle menu">
      <svg id="navIconOpen" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="navIconClose" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- ============ MOBILE NAV PANEL ============ -->
  <nav class="lg:hidden hidden flex-col gap-1 px-6 pb-6 bg-paper border-t border-line max-h-[80vh] overflow-y-auto" id="mobileNav">
    <a href="/" class="py-3 font-display font-medium text-sm border-b border-line/70">Home</a>

    <details class="border-b border-line/70 group/d">
      <summary class="py-3 font-display font-medium text-sm cursor-pointer list-none flex items-center justify-between">
        Catalog
        <svg class="w-3.5 h-3.5 transition-transform group-open/d:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </summary>
      <div class="pb-3 pl-3">
        <% navCategories.forEach(function(cat){ %>
          <div class="mb-3">
            <a href="/catalog#<%= cat.slug %>" class="font-display font-medium text-[13px] text-ink block mb-1.5"><%= cat.name %></a>
            <ul class="space-y-1.5 pl-3 border-l border-line">
              <% cat.subcategories.forEach(function(sub){ %>
                <li><a href="/catalog/<%= sub.slug %>" class="text-[13px] text-ink-soft block"><%= sub.shortName || sub.name %></a></li>
              <% }) %>
            </ul>
          </div>
        <% }) %>
      </div>
    </details>

    <a href="/about" class="py-3 font-display font-medium text-sm border-b border-line/70">About</a>
    <a href="/contact" class="py-3 font-display font-medium text-sm border-b border-line/70">Contact</a>
    <a href="/sample-request" class="btn btn-primary justify-center mt-4">Request Samples</a>
  </nav>
</header>
