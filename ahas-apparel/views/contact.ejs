<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <section class="bg-denim-deep text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="font-mono text-xs text-tan mb-5"><a href="/" class="hover:text-white">Home</a> / Contact</div>
      <div class="eyebrow eyebrow-light">Get In Touch</div>
      <h1 class="text-4xl md:text-5xl text-white mb-4">Contact Sales</h1>
      <p class="text-[#C6CFDA] max-w-lg text-lg normal-case font-normal tracking-normal">Tell us about your product and volume — we typically reply within one business day.</p>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-[760px] mx-auto px-6">
      <form class="reveal bg-white border border-line rounded-sm p-8 md:p-10" id="contactForm">
        <div class="grid sm:grid-cols-2 gap-5 mb-5">
          <div class="flex flex-col gap-1.5">
            <label for="name" class="font-mono text-[11px] tracking-wide uppercase text-ink-soft">Full Name *</label>
            <input type="text" id="name" name="name" required class="font-body text-sm px-4 py-3 border border-line rounded-sm bg-paper focus:outline-none focus:border-denim focus:bg-white transition-colors">
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="company" class="font-mono text-[11px] tracking-wide uppercase text-ink-soft">Company</label>
            <input type="text" id="company" name="company" class="font-body text-sm px-4 py-3 border border-line rounded-sm bg-paper focus:outline-none focus:border-denim focus:bg-white transition-colors">
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-5 mb-5">
          <div class="flex flex-col gap-1.5">
            <label for="email" class="font-mono text-[11px] tracking-wide uppercase text-ink-soft">Email *</label>
            <input type="email" id="email" name="email" required class="font-body text-sm px-4 py-3 border border-line rounded-sm bg-paper focus:outline-none focus:border-denim focus:bg-white transition-colors">
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="phone" class="font-mono text-[11px] tracking-wide uppercase text-ink-soft">Phone</label>
            <input type="tel" id="phone" name="phone" class="font-body text-sm px-4 py-3 border border-line rounded-sm bg-paper focus:outline-none focus:border-denim focus:bg-white transition-colors">
          </div>
        </div>
        <div class="mb-5">
          <div class="flex flex-col gap-1.5">
            <label for="message" class="font-mono text-[11px] tracking-wide uppercase text-ink-soft">Message *</label>
            <textarea id="message" name="message" rows="5" required placeholder="What are you looking to produce, and roughly what volume?" class="font-body text-sm px-4 py-3 border border-line rounded-sm bg-paper focus:outline-none focus:border-denim focus:bg-white transition-colors resize-y"></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary w-full sm:w-auto justify-center">Send Message</button>
        <div class="hidden" id="contactStatus"></div>
        <p class="text-sm text-ink-soft mt-4">Prefer instant reply? <a href="https://wa.me/<%= site.whatsapp %>" target="_blank" rel="noopener" class="text-orange-deep hover:underline">Message us on WhatsApp</a> or email <a href="mailto:<%= site.email %>" class="text-orange-deep hover:underline"><%= site.email %></a>.</p>
      </form>
    </div>
  </section>

  <%- include('partials/footer', { categoriesList: [] }) %>
  <%- include('partials/float-widgets') %>
  <script src="/js/main.js"></script>
</body>
</html>
